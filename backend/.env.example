# MongoDB Connection
MONGODB_URI=tu_uri_de_mongodb_aqui
PORT=5000

# JWT Configuration
JWT_SECRET=tu_secreto_jwt_aqui

# Base URL for API (importante para URLs de imágenes)
# En desarrollo: http://localhost:5000
# En producción: https://proyecto-fgm-backend.onrender.com
BASE_URL=http://localhost:5000

# Google OAuth (Opcional)
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_password_o_app_password
EMAIL_FROM=Tu Nombre <tu_email@gmail.com>

# Alternative SMTP Servers
OUTLOOK_HOST=smtp-mail.outlook.com
OUTLOOK_PORT=587

HOTMAIL_HOST=smtp-mail.outlook.com
HOTMAIL_PORT=587

GMAIL_HOST=smtp.gmail.com
GMAIL_PORT=587
